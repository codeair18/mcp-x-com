# Browser session
X_BROWSER_HEADLESS=false
X_BROWSER_PROFILE_DIR=.auth/x-profile
# When set, connecting over CDP takes precedence over the persistent profile.
X_BROWSER_CDP_URL=
X_BROWSER_LOCALE=en-US
X_BROWSER_TIMEOUT_MS=15000

# Read limits
X_MAX_READ_ITEMS=20

# Write safety
X_ACTION_TOKEN_TTL_MS=120000
X_WRITE_RATE_PER_HOUR=10

# Diagnostics (screenshots are only saved when explicitly enabled)
X_ARTIFACTS_DIR=artifacts
X_SAVE_ERROR_ARTIFACTS=false
LOG_LEVEL=info
